# انسخ هذا الملف إلى .env وعدّل القيم

PORT=4000
# غيّر هذا المفتاح إلى نص طويل عشوائي قبل النشر
JWT_SECRET=change-me-to-a-long-random-string

# development: رمز التحقق يظهر في الطرفية ويرجع في الرد (للتجربة فقط)
# production: يجب ربط مزود رسائل SMS في src/sms.js
NODE_ENV=development

# حساب المدير الأول (يُنشأ تلقائياً عند أول تشغيل)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# مدة حفظ الرسائل الصوتية والتسجيلات بعد إغلاق الطلب (بالأيام)
RETENTION_DAYS=60

# مهلة قبول الطلب لكل موصّل (بالثواني)
OFFER_TIMEOUT_SECONDS=30

# ---------------- المكالمات المسجلة (Agora) ----------------
# اتركها فارغة لتعطيل المكالمات؛ التطبيق يقترح الرسائل الصوتية بدلاً منها
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# مفاتيح REST من لوحة Agora (لتشغيل التسجيل السحابي)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# التخزين الذي يحفظ فيه Agora التسجيلات (متوافق مع S3)
# vendor: 1 = Amazon S3، راجع وثائق Agora لباقي المزودين
AGORA_STORAGE_VENDOR=1
AGORA_STORAGE_REGION=0
AGORA_STORAGE_BUCKET=
AGORA_STORAGE_ACCESS_KEY=
AGORA_STORAGE_SECRET_KEY=
# الرابط العام للحاوية، يستعمل لتشغيل التسجيلات من لوحة الإدارة
AGORA_STORAGE_PUBLIC_URL=
