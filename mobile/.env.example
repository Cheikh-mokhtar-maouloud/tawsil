# عنوان الخادم كما يراه الهاتف. انسخ هذا الملف إلى .env
# الهاتف لا يرى "localhost": اكتب عنوان IP لجهاز الكمبيوتر في نفس شبكة الواي فاي
# (في Windows: افتح cmd واكتب ipconfig وابحث عن IPv4 Address)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# رقم الدعم الذي يظهر في صفحة «حسابي» (اختياري)
EXPO_PUBLIC_SUPPORT_PHONE=

# expo/fetch (SDK 57) لا يدعم ملفات {uri,name,type} في FormData، لذلك نستعمل fetch الخاص بـ React Native لرفع الصوت والصور
EXPO_PUBLIC_USE_RN_FETCH=1
